# 1000x1 Experiment Environment Variables

# ----------------------------------------------------
# SUPABASE (Source of Truth)
# ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ----------------------------------------------------
# IDENTITY SECURITY
# ----------------------------------------------------
# Se usa para hashear el identificador de PayPal y evitar guardar correos en texto plano
IDENTITY_SALT_SECRET=generate_a_random_secure_string_for_hashing

# ----------------------------------------------------
# PAYPAL
# ----------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------
# POSTHOG (Analytics)
# ----------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
